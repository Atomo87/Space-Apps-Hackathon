APP_NAME=GeoSafra
# Produção: APP_ENV=production e APP_DEBUG=false (as páginas de erro amigáveis só aparecem com debug desligado)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Produção: LOG_LEVEL=warning
LOG_LEVEL=debug

# MySQL 8 (XAMPP/Hostinger). Para testar sem MySQL: DB_CONNECTION=sqlite (cria database/database.sqlite)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=geosafra
DB_USERNAME=root
DB_PASSWORD=

# Sessão em banco: necessária para login e para a API interna (cookie + CSRF).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produção com HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# O cache também guarda os locks (processamento do talhão, criação do exemplo público).
CACHE_STORE=database

# A análise do talhão é disparada pelo navegador (funciona sem worker, inclusive em hospedagem compartilhada).
# Com worker (composer dev), pode usar QUEUE_CONNECTION=database.
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- geo-service (Python/FastAPI): NASA POWER, SRTM, indicadores e motor de rotação ---
# Local: uvicorn na porta 8001. Sail: http://geo-service:8001. Render: https://<seu-servico>.onrender.com
GEO_SERVICE_URL=http://127.0.0.1:8001
GEO_SERVICE_TIMEOUT=240
# Igual ao GEOSAFRA_TOKEN gerado no Render (vazio em dev local)
GEO_SERVICE_TOKEN=
# Opcional: período da climatologia (padrão do geo-service: 2005–2025)
POWER_START_YEAR=
POWER_END_YEAR=
