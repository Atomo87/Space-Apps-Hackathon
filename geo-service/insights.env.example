# Copiar os campos desejados para o .env local. Nao colocar chaves reais no Git.
# A analise e o fallback funcionam sem Gemini.
INSIGHTS_ENABLED=false
GEMINI_API_KEY=
# Escolher um modelo de texto disponivel na conta, com suporte a JSON Schema.
GEMINI_MODEL=
INSIGHTS_TIMEOUT_SECONDS=30
INSIGHTS_MAX_OUTPUT_TOKENS=1600
INSIGHTS_SNAPSHOT_TTL_HOURS=24
# Opcional: diretorio de JSONs revisados. Por padrao: knowledge/ deste servico.
# RAG_KNOWLEDGE_DIR=C:/caminho/knowledge
