# Copie para geo-service/.env (fora do git). Variáveis do ambiente real têm prioridade sobre este arquivo.

# Token compartilhado com o Laravel (cabeçalho X-GeoSafra-Token). Vazio = sem verificação (só em desenvolvimento).
GEOSAFRA_TOKEN=

# Token de serviço NASA Earthdata (urs.earthdata.nasa.gov › Generate Token). Liga SMAP, GPM IMERG, ECOSTRESS e GRACE-FO.
# Para o GPM, a conta também precisa aceitar o EULA da GES DISC. O token expira: troque quando vencer.
EARTHDATA_TOKEN=

# Opcionais (valores padrão entre parênteses)
# POWER_START_YEAR=2005  POWER_END_YEAR=2025
# NDVI_YEARS=5  HLS_YEARS=2  LST_YEARS=3  ET_YEARS=5
# SMAP_YEARS=2  SMAP_STEP_DAYS=5  GPM_YEARS=10  ECOSTRESS_YEARS=2
# PC_CONCURRENCY=10  EARTHDATA_CONCURRENCY=10
