# Worker do mapa (MapLibre) é um módulo .mjs: sem este tipo, o Apache o serve sem Content-Type e o navegador o recusa.
<IfModule mod_mime.c>
    AddType text/javascript .mjs
</IfModule>

# Hostinger (LiteSpeed): não matar o PHP quando a resposta já foi enviada — o processamento
# das análises continua em segundo plano depois que a página recebe "processing".
<IfModule LiteSpeed>
    SetEnv noabort 1
    SetEnv noconntimeout 1
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteRule .* - [E=noabort:1,E=noconntimeout:1]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
